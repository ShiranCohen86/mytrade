# ═══════════════════════════════════════════════════════════════════════════
#  MyTrade — Backend environment template
#  Copy to `.env` and fill in. In production (Render) set these in the
#  dashboard → Environment, NOT via a committed file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core (required) ──────────────────────────────────────────────────────────
PORT=5000
# MongoDB connection string. If unset, the server falls back to a local
# in-memory/JSON store (data is lost on restart) — fine for dev, not production.
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mytrade

# ── Authentication (JWT) — required for login ────────────────────────────────
# Generate each: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Web Push (VAPID) — required for push notifications ───────────────────────
# Generate the pair: node -e "console.log(require('web-push').generateVAPIDKeys())"
# If unset, push is cleanly disabled (alerts/digests simply won't be delivered).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── URLs / CORS ──────────────────────────────────────────────────────────────
# Frontend origin allowed by CORS in development (Vite :3000 → Express :5000).
# In production (same-origin single service) leave unset — CORS becomes a no-op.
ALLOWED_ORIGIN=http://localhost:3000
# Base URL of the frontend — used in password-reset emails and OAuth redirects.
CLIENT_URL=http://localhost:3000

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Get credentials at https://console.cloud.google.com/apis/credentials
# If unset, Google Sign-In is disabled (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ── Email / SMTP (optional — for password reset) ─────────────────────────────
# If unset, reset links are printed to the server log instead of emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password

# ── News & Sentiment (optional) ──────────────────────────────────────────────
# Free key (100 req/day) at https://newsapi.org. Leave blank to use Google News RSS.
NEWS_API_KEY=
NEWS_PROVIDER=googlerss

# ── Cache & Cron (optional — sensible defaults) ──────────────────────────────
CACHE_TTL_MINUTES=60
CRON_SCHEDULE=0 */2 * * *

# ── Runtime (set by the platform, not here) ──────────────────────────────────
# NODE_ENV=production
