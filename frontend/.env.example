# ═══════════════════════════════════════════════════════════════════════════
#  MyTrade — Frontend environment template (Vite)
#  Copy to `.env`. Only VITE_-prefixed vars are exposed to the client.
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of the Express API. Leave blank to use same-origin (production) or
# the Vite dev proxy (development, which forwards /api, /auth, /admin, /health).
# Example for split hosting: VITE_EXPRESS_URL=https://api.mytrade.app
VITE_EXPRESS_URL=
